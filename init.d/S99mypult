#!/bin/sh
#
# /etc/init.d/S99mypult — автозапуск веб-пульта «Станция Миди»
#
#   /etc/init.d/S99mypult start     запустить всё недостающее
#   /etc/init.d/S99mypult stop      остановить только то, что запустили мы
#   /etc/init.d/S99mypult restart   полный перезапуск
#   /etc/init.d/S99mypult reload    перезапустить только lighttpd
#   /etc/init.d/S99mypult status    что сейчас работает
#
# Скрипт идемпотентен: уже запущенные процессы он не дублирует и чужие
# процессы не убивает (останавливает только по своим pid-файлам).

### BEGIN INIT INFO
# Provides:          mypult
# Required-Start:    $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

DAEMON_LUNA="/data/quazar/luna/bin/luna"
LUNA_ARGS="--listen 127.0.0.1:8099 --data-dir /data/quazar/luna/data"
LIGHTTPD="/opt/sbin/lighttpd"
LIGHTTPD_CONF="/opt/etc/lighttpd/myweb.conf"
WEBROOT="/data/myweb"
PY="/opt/bin/python3"

# Время станции не меняем.


# Мост к IPC aliced для озвучки. Если на колонке порт 9875 уже слушает
# socat/aliced — оставьте пустым. Иначе укажите unix-сокет aliced, например:
# IPC_SOCK="/var/run/aliced.sock"
IPC_SOCK=""

RUNDIR="/tmp/mypult"
LOG="/tmp/mypult.log"
LIGHTTPD_PIDFILE="/tmp/mypult-lighttpd.pid"

log() {
    # В режиме ensure (раз в минуту) не засоряем лог сообщениями «уже работает».
    if [ "${QUIET:-0}" = "1" ]; then
        case "$*" in
            *"уже"*|*"не трогаю"*) return 0 ;;
        esac
    fi
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
        mv -f "$LOG" "$LOG.1" 2>/dev/null
    fi
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"
}

# PID из файла должен принадлежать именно нашему процессу: после перезагрузки
# PID переиспользуется, и проверка «kill -0» может принять чужой процесс за свой.
pid_matches() {
    _file="$1"
    _pattern="$2"
    [ -f "$_file" ] || return 1
    _pid=$(cat "$_file" 2>/dev/null)
    [ -n "$_pid" ] || return 1
    kill -0 "$_pid" 2>/dev/null || return 1
    tr '\000' ' ' <"/proc/$_pid/cmdline" 2>/dev/null | grep -q "$_pattern" || return 1
    return 0
}

# Найти процессы по подстроке в cmdline. Нужно, когда pid-файл потерялся
# или указывает на уже умерший процесс, а старый демон всё ещё держит порт.
find_pids() {
    _pattern="$1"
    for _cmdline in /proc/[0-9]*/cmdline; do
        _pid=${_cmdline#/proc/}
        _pid=${_pid%/cmdline}
        [ -r "$_cmdline" ] || continue
        tr '\000' ' ' <"$_cmdline" 2>/dev/null | grep -q "$_pattern" && echo "$_pid"
    done
}

# Проверка TCP-порта через /proc/net/tcp (без netstat и nc).
is_listening() {
    _hex=$(printf '%04X' "$1")
    awk -v p=":$_hex" '$4 == "0A" && index($2, p) > 0 { found = 1 } END { exit !found }' \
        /proc/net/tcp 2>/dev/null
}

# true, если порт 8099 слушает не loopback (0.0.0.0/::).
luna_on_lan() {
    _hex=$(printf '%04X' 8099)
    awk -v p=":$_hex" '
        $4 == "0A" && index($2, p) > 0 {
            split($2, a, ":");
            if (a[1] != "0100007F" &&
                a[1] != "00000000000000000000000001000000") found = 1
        }
        END { exit found ? 0 : 1 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

wait_root() {
    i=0
    while [ ! -d "$WEBROOT" ] && [ "$i" -lt 30 ]; do
        sleep 1
        i=$((i + 1))
    done
    if [ ! -d "$WEBROOT" ]; then
        log "НЕТ каталога $WEBROOT — пульт не запускаю"
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------ Luna ----
# Luna из YAM (/etc/init.d/S99luna) — чужая: не запускаем свою копию и не
# трогаем порт, иначе после остановки YAM-версии займём 8099 старой сборкой.
luna_owned_by_yam() {
    [ -e /etc/init.d/S99luna ] || [ -d /data/yam/pkgs/yam/luna ]
}

start_luna() {
    if luna_owned_by_yam; then
        log "luna: управляется YAM (S99luna) — свою копию не запускаю"
        return 0
    fi
    if is_listening 8099; then
        if luna_on_lan; then
            if [ -f "$RUNDIR/luna.pid" ]; then
                log "luna: слушает LAN — перезапускаю только на 127.0.0.1"
                stop_pidfile "$RUNDIR/luna.pid" "luna"
                sleep 1
            else
                log "luna: 8099 занят не-loopback процессом — нужен ручной перезапуск"
                return 1
            fi
        fi
        if is_listening 8099; then
            log "luna: уже слушает 8099"
            return 0
        fi
    fi
    if [ ! -x "$DAEMON_LUNA" ]; then
        log "luna: НЕТ исполняемого $DAEMON_LUNA"
        return 1
    fi
    nohup "$DAEMON_LUNA" $LUNA_ARGS >>"$LOG" 2>&1 &
    echo $! >"$RUNDIR/luna.pid"
    i=0
    while [ "$i" -lt 20 ]; do
        if is_listening 8099; then
            log "luna: запущена, pid $(cat "$RUNDIR/luna.pid" 2>/dev/null)"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    log "luna: не поднялась за 20 с (см. $LOG)"
    return 1
}

# -------------------------------------------------------------- lighttpd ----
start_web() {    if is_listening 8055; then
        log "lighttpd: порт 8055 уже занят, не трогаю"
        return 0
    fi
    if [ ! -x "$LIGHTTPD" ]; then
        log "lighttpd: НЕТ $LIGHTTPD"
        return 1
    fi
    if ! "$LIGHTTPD" -t -f "$LIGHTTPD_CONF" >>"$LOG" 2>&1; then
        log "lighttpd: КОНФИГ НЕВАЛИДЕН ($LIGHTTPD_CONF), запуск отменён"
        return 1
    fi
    if ! "$LIGHTTPD" -f "$LIGHTTPD_CONF" >>"$LOG" 2>&1; then
        log "lighttpd: не стартовал"
        return 1
    fi
    sleep 1
    if is_listening 8055; then
        log "lighttpd: слушает 8055"
        return 0
    fi
    log "lighttpd: запустился, но 8055 не слушается"
    return 1
}

# ----------------------------------------------------------- голос -----------
start_voice() {
    [ -f /data/mypult/voice_daemon.py ] || return 0
    if pid_matches /data/mypult/voice.pid "voice_daemon.py"; then
        log "голосовой пульт: уже работает (pid $(cat /data/mypult/voice.pid 2>/dev/null))"
        return 0
    fi
    if [ -x /opt/bin/curl ]; then
        # ensure, а не start: если пользователь выключил пульт в панели,
        # watchdog не должен поднимать его обратно каждую минуту.
        /opt/bin/curl -s -m 30 -X POST http://127.0.0.1:8055/cgi-bin/voicectl.py \
            -H 'Content-Type: application/json' -d '{"ensure":1}' >/dev/null 2>&1
    fi
    sleep 2
    if pid_matches /data/mypult/voice.pid "voice_daemon.py"; then
        log "голосовой пульт: запущен (pid $(cat /data/mypult/voice.pid 2>/dev/null))"
        return 0
    fi
    if [ -f /data/mypult/voice.json ] && grep -q '"enabled": *false' /data/mypult/voice.json 2>/dev/null; then
        log "голосовой пульт: выключен пользователем"
        return 0
    fi
    log "голосовой пульт: НЕ стартовал"
    return 1
}

stop_voice() {
    if [ -x /opt/bin/curl ]; then
        # kill, а не stop: остановка сервиса не должна означать «пользователь
        # выключил голосовой пульт навсегда».
        /opt/bin/curl -s -m 15 -X POST http://127.0.0.1:8055/cgi-bin/voicectl.py \
            -H 'Content-Type: application/json' -d '{"kill":1}' >/dev/null 2>&1
    fi
    if [ -f /data/mypult/voice.pid ]; then
        _pid=$(cat /data/mypult/voice.pid 2>/dev/null)
        [ -n "$_pid" ] && kill "$_pid" 2>/dev/null
        rm -f /data/mypult/voice.pid
    fi
}

start_state() {
    [ -f /data/mypult/state_daemon.py ] || return 0
    if pid_matches /tmp/mypult-state.pid "state_daemon.py"; then
        log "state: уже работает (pid $(cat /tmp/mypult-state.pid 2>/dev/null))"
        return 0
    fi
    if is_listening 8057; then
        _state_pid=$(find_pids "state_daemon.py" | head -1)
        if [ -n "$_state_pid" ]; then
            echo "$_state_pid" > /tmp/mypult-state.pid
            log "state: уже слушает 8057 (pid $_state_pid)"
            return 0
        fi
    fi
    nohup /opt/bin/python3 /data/mypult/state_daemon.py >>/tmp/mypult.log 2>&1 &
    echo $! > /tmp/mypult-state.pid
    sleep 1
    if pid_matches /tmp/mypult-state.pid "state_daemon.py"; then
        log "state: запущен на 8057"
    else
        log "state: НЕ стартовал (панель использует CGI)"
    fi
}

stop_state() {
    if pid_matches /tmp/mypult-state.pid "state_daemon.py"; then
        kill "$(cat /tmp/mypult-state.pid 2>/dev/null)" 2>/dev/null
    fi
    # Если pid-файл потерялся, всё равно не оставляем старый демон на 8057.
    for _pid in $(find_pids "state_daemon.py"); do
        [ "$_pid" = "$$" ] && continue
        kill "$_pid" 2>/dev/null
    done
    rm -f /tmp/mypult-state.pid
}

# --------------------------------------------------------- микрофон (tap) ----
# Приёмник кадров от vqe_tap.so. Запускается только когда tap включён: без него
# это лишние ~35 МБ RAM на колонке.
start_mic() {
    [ -f /data/mypult/micd.py ] || return 0
    if [ ! -f /data/mypult/mictap.json ] || \
       ! grep -q '"enabled": *true' /data/mypult/mictap.json 2>/dev/null; then
        log "mic: tap выключен — приёмник не запускаю"
        return 0
    fi
    if pid_matches /tmp/mypult-mic.pid "micd.py"; then
        log "mic: уже работает (pid $(cat /tmp/mypult-mic.pid 2>/dev/null))"
        return 0
    fi
    nohup /opt/bin/python3 /data/mypult/micd.py >>/tmp/mypult.log 2>&1 &
    echo $! > /tmp/mypult-mic.pid
    sleep 1
    if pid_matches /tmp/mypult-mic.pid "micd.py"; then
        log "mic: приёмник запущен"
    else
        log "mic: приёмник НЕ стартовал (см. /tmp/mypult.log)"
    fi
}

stop_mic() {
    if pid_matches /tmp/mypult-mic.pid "micd.py"; then
        kill "$(cat /tmp/mypult-mic.pid 2>/dev/null)" 2>/dev/null
    fi
    for _pid in $(find_pids "micd.py"); do
        [ "$_pid" = "$$" ] && continue
        kill "$_pid" 2>/dev/null
    done
    rm -f /tmp/mypult-mic.pid
}

# --------------------------------------------------------- микрофон (tap) ----
# /etc на прошивке только для чтения, поэтому отдельный S96 с монтажом
# launch.json туда не положить. Монтируем здесь и, если maind ещё без
# LD_PRELOAD, один раз перезапускаем quasar. Метка в /tmp не даёт зациклиться,
# если прошивка почему-то не подхватывает preload.
ensure_mic_tap() {
    [ -f /data/mypult/mictap.json ] || return 0
    grep -q '"enabled": *true' /data/mypult/mictap.json 2>/dev/null || return 0
    [ -f /data/myweb/deploy/mic-tap.sh ] || return 0
    sh /data/myweb/deploy/mic-tap.sh mount >>"$LOG" 2>&1
    _pid=$(ps w 2>/dev/null | awk '/[m]aind --platformd/ {print $1; exit}')
    if [ -z "${_pid:-}" ]; then
        log "mic-tap: maind не найден — монтирование отложено"
        return 0
    fi
    if tr '\000' '\n' <"/proc/$_pid/environ" 2>/dev/null | grep -q MYPULT_MIC_SOCKET; then
        log "mic-tap: maind уже с LD_PRELOAD"
        return 0
    fi
    if [ -f "$RUNDIR/mic-restarted" ]; then
        log "mic-tap: перезапуск уже был, preload не подхватился — нужен ручной разбор"
        return 0
    fi
    : >"$RUNDIR/mic-restarted"
    log "mic-tap: перезапускаю quasar, чтобы maind взял LD_PRELOAD"
    sh /data/myweb/deploy/mic-tap.sh restart >>"$LOG" 2>&1
}

# --------------------------------------------------------------- watchdog ----
# Раз в минуту проверяем только критичные процессы и поднимаем то, что упало.
# Без этого voice_daemon (вместе с будильниками) и state_daemon жили до
# перезагрузки, даже если умирали от OOM или исключения.
start_watchdog() {
    if pid_matches "$RUNDIR/watchdog.pid" "S99mypult"; then
        log "watchdog: уже работает"
        return 0
    fi
    nohup sh -c 'while :; do sleep 60; /opt/etc/init.d/S99mypult ensure >>/tmp/mypult.log 2>&1; done' \
        >/dev/null 2>&1 &
    echo $! >"$RUNDIR/watchdog.pid"
    log "watchdog: запущен (pid $!)"
}

stop_watchdog() {
    stop_pidfile "$RUNDIR/watchdog.pid" "watchdog"
}

# ------------------------------------------------ IPC-мост на 9875 (опция) --
start_ipc() {
    if [ -z "$IPC_SOCK" ]; then
        return 0
    fi
    if is_listening 9875; then
        log "ipc: 9875 уже слушает"
        return 0
    fi
    SOCAT=$(command -v socat 2>/dev/null || echo /opt/bin/socat)
    if [ ! -x "$SOCAT" ]; then
        log "ipc: НЕТ socat — озвучка через speak.py будет недоступна"
        return 0
    fi
    if [ ! -S "$IPC_SOCK" ]; then
        log "ipc: НЕТ сокета $IPC_SOCK"
        return 0
    fi
    nohup "$SOCAT" TCP-LISTEN:9875,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:"$IPC_SOCK" >>"$LOG" 2>&1 &
    echo $! >"$RUNDIR/socat.pid"
    log "ipc: socat слушает 9875 -> $IPC_SOCK"
    return 0
}

# ------------------------------------------------------------------- stop ----
stop_pidfile() {
    _file="$1"
    _name="$2"
    [ -f "$_file" ] || return 0
    _pid=$(cat "$_file" 2>/dev/null)
    if [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null; then
        kill "$_pid" 2>/dev/null
        log "$_name: остановлен (pid $_pid)"
    fi
    rm -f "$_file"
}

stop_web() {
    stop_pidfile "$LIGHTTPD_PIDFILE" "lighttpd"
    i=0
    while is_listening 8055 && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    if is_listening 8055; then
        log "lighttpd: 8055 всё ещё занят (чужой процесс?) — не трогаю"
    fi
}

start_ipv6() {
    [ -f "$WEBROOT/cgi-bin/ipv6.py" ] || return 0
    [ -x "$PY" ] || { log "ipv6: нет $PY — настройка не применена"; return 0; }
    "$PY" "$WEBROOT/cgi-bin/ipv6.py" --apply >/dev/null 2>&1 || \
        log "ipv6: не удалось применить сохранённую настройку"
    # Сеть может подняться позже и снова включить IPv6 — повторяем после старта.
    ( sleep 25; "$PY" "$WEBROOT/cgi-bin/ipv6.py" --apply >/dev/null 2>&1 ) &
}

reload_web() {
    # SIGHUP перечитывает конфиг без обрыва соединений — вкладки не отваливаются.
    pid=$(cat "$LIGHTTPD_PIDFILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null; then
        sleep 1
        if is_listening 8055; then
            log "lighttpd: мягко перезагружен"
            return 0
        fi
    fi
    log "lighttpd: мягкий reload не удался, перезапускаю"
    stop_web
    start_web
}

restore_volume() {
    [ -f /data/mypult/volume.json ] || return 0
    level=$(sed -n 's/.*"level"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        /data/mypult/volume.json | head -n 1)
    [ -n "$level" ] || return 0
    if /usr/bin/amixer sset Master "${level}%" >/dev/null 2>&1; then
        log "громкость: ${level}%"
    fi
}

stop_all() {
    stop_watchdog
    stop_voice
    stop_state
    stop_mic
    stop_web
    stop_pidfile "$RUNDIR/socat.pid" "socat"
    stop_pidfile "$RUNDIR/luna.pid" "luna"
}

# ----------------------------------------------------------------- status ----
status_all() {
    _ver=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$WEBROOT/version.json" 2>/dev/null | head -n 1)
    if [ -n "$_ver" ]; then
        echo "mypult     : v$_ver"
    else
        echo "mypult     : версия не найдена ($WEBROOT/version.json)"
    fi
    if is_listening 8099; then echo "luna       : up   (8099)"; else echo "luna       : down"; fi
    if is_listening 9875; then echo "ipc 9875   : up"; else echo "ipc 9875   : down"; fi
    if is_listening 8055; then echo "lighttpd   : up   (8055)"; else echo "lighttpd   : down"; fi
    if pid_matches /data/mypult/voice.pid "voice_daemon.py"; then
        echo "voice      : up   (pid $(cat /data/mypult/voice.pid 2>/dev/null))"
    else
        echo "voice      : down"
    fi
    if pid_matches /tmp/mypult-state.pid "state_daemon.py"; then
        echo "state      : up   (8057)"
    else
        echo "state      : down"
    fi
    if pid_matches /tmp/mypult-mic.pid "micd.py"; then
        echo "mic        : up   (8058)"
    else
        echo "mic        : down"
    fi
    if pid_matches "$RUNDIR/watchdog.pid" "S99mypult"; then
        echo "watchdog   : up"
    else
        echo "watchdog   : down"
    fi
}

# ------------------------------------------------ подсветка кольца -----------
start_ring_backlight() {
    B=/sys/class/backlight/fb0/brightness
    if [ -f /data/mypult/ring.json ] && [ -x /opt/bin/curl ]; then
        i=0
        while [ "$i" -lt 15 ]; do
            is_listening 8055 && break
            sleep 1
            i=$((i + 1))
        done
        /opt/bin/curl -s -m 10 -X POST "http://127.0.0.1:8055/cgi-bin/display.py" \
            -H "Content-Type: application/json" -d '{"restore":1}' >>"$LOG" 2>&1
        log "ring: яркость восстановлена из настроек"
    elif [ -w "$B" ] && [ "$(cat "$B" 2>/dev/null)" = "0" ]; then
        echo 255 >"$B" 2>/dev/null && log "ring: подсветка fb0 включена"
    fi
    for C in /sys/bus/i2c/devices/1-0034/current /sys/bus/i2c/devices/1-0035/current; do
        [ -w "$C" ] || continue
        if [ "$(cat "$C" 2>/dev/null)" = "0" ]; then
            echo 5 >"$C" 2>/dev/null && log "ring: ток LED-контроллера включён"
        fi
    done
}

# ------------------------------------------------ DNS: автоприменение --------
port53_listening() {
    awk -v p=":0035" 'index($2, p) > 0 { found = 1 } END { exit !found }' \
        /proc/net/udp /proc/net/udp6 2>/dev/null
}

# Резолвер прошивки (unbound) иногда не поднимается: IPv6 на loopback выключен,
# и unbound не может занять ::1. Чиним только если :53 никто не слушает.
ensure_dns() {
    port53_listening && return 0
    [ -x /usr/sbin/unbound ] || { log "dns: unbound не найден"; return 0; }
    log "dns: :53 не слушает — пробую поднять unbound"
    if [ "$(cat /proc/sys/net/ipv6/conf/lo/disable_ipv6 2>/dev/null)" = "1" ]; then
        echo 0 > /proc/sys/net/ipv6/conf/lo/disable_ipv6 2>/dev/null || true
        sleep 1
    fi
    if [ -x /etc/init.d/S70unbound ]; then
        /etc/init.d/S70unbound start >/dev/null 2>&1 || true
    else
        /usr/sbin/unbound >/dev/null 2>&1 || true
    fi
    sleep 2
    if port53_listening; then
        log "dns: unbound поднят"
    else
        log "dns: unbound не поднялся"
    fi
}

start_dns_auto() {
    [ -f /data/mypult/dns.json ] || return 0
    [ -x /opt/bin/curl ] || return 0
    i=0
    while [ "$i" -lt 15 ]; do
        is_listening 8055 && break
        sleep 1
        i=$((i + 1))
    done
    /opt/bin/curl -s -m 60 -X POST "http://127.0.0.1:8055/cgi-bin/network.py" \
        -H "Content-Type: application/json" -d '{"action":"dns_apply_saved"}' >>"$LOG" 2>&1
    log "dns: пользовательские серверы применены"
}

# ------------------------------------------------ VPN: автозапуск (опция) ----
start_vpn_auto() {
    [ -f /data/mypult/vpn.autostart ] || return 0
    [ -x /opt/bin/curl ] || return 0
    i=0
    while [ "$i" -lt 15 ]; do
        is_listening 8055 && break
        sleep 1
        i=$((i + 1))
    done
    /opt/bin/curl -s -m 120 -X POST "http://127.0.0.1:8055/cgi-bin/vpn.py" \
        -H "Content-Type: application/json" -d '{"start":1}' >>"$LOG" 2>&1
    log "vpn: автозапуск выполнен"
}

# -------------------------------------------------------------------- main ---
mkdir -p "$RUNDIR" 2>/dev/null

case "$1" in
    start)
        wait_root || exit 1
        start_ipc
        start_luna
        start_web
        start_ipv6
        ensure_dns
        restore_volume
        start_voice
        start_state
        start_mic
        start_ring_backlight
        start_dns_auto
        start_vpn_auto
        start_watchdog
        ensure_mic_tap
        ;;
    ensure)
        # Только то, что должно работать постоянно; watchdog вызывает это раз
        # в минуту. Никаких сетевых настроек и перезапусков Luna.
        QUIET=1
        wait_root || exit 1
        start_luna
        start_web
        start_voice
        start_state
        start_mic
        ;;
    watch)
        start_watchdog
        ;;
    stop)
        stop_all
        ;;
    restart)
        stop_all
        sleep 1
        wait_root || exit 1
        start_ipc
        start_luna
        start_web
        start_ipv6
        restore_volume
        start_voice
        start_state
        start_mic
        start_ring_backlight
        start_dns_auto
        start_vpn_auto
        start_watchdog
        ;;
    reload)
        # SIGHUP в этой сборке не перечитывает конфиг, поэтому применяем
        # изменения полным перезапуском веба и зависимых процессов.
        stop_voice
        stop_state
        stop_mic
        stop_web
        sleep 1
        start_luna
        start_web
        restore_volume
        start_voice
        start_state
        start_mic
        start_watchdog
        ensure_mic_tap
        ;;
    status)
        status_all
        ;;
    *)
        echo "Использование: $0 {start|stop|restart|reload|ensure|watch|status}"
        exit 1
        ;;
esac

exit 0
